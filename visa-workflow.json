      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Fetch Telegram Channel HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        380,
        240
      ]
    },
    {
      "parameters": {
        "sourceKey": "data",
        "extractionValues": {
          "values": [
            {
              "key": "text",
              "cssSelector": ".tgme_widget_message_text",
              "returnValue": "text",
              "returnArray": true
            }
          ]
        }
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Extract Message Texts",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1,
      "position": [
        560,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length === 0 || !items[0].json.text || items[0].json.text.length === 0) {\n  return [];\n}\n\nconst messages = items[0].json.text;\nconst latestMessage = messages[messages.length - 1];\n\nreturn [ { json: { latest_message: latestMessage } } ];"
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Get Latest Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        240
      ]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "mode": "list",
          "value": "36bb03d4-b238-81e1-bcdb-e5fb769c90c6"
        },
        "limit": 1,
        "options": {
          "sort": {
            "sorts": [
              {
                "property": "Published Date",
                "direction": "descending"
              }
            ]
          }
        }
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Get Last Saved Notion Entry",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.1,
      "position": [
        920,
        240
      ],
      "alwaysOutputData": true,
      "credentials": {
        "notionApi": {
          "id": "1",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const latestScraped = $('Get Latest Message').first().json.latest_message;\nconst lastSaved = $input.first().json;\n\n// Extract the title of the last saved Notion entry\n// In n8n Notion v2.1, title property returns plain_text in nested object\nlet lastSavedTitle = \"\";\ntry {\n  lastSavedTitle = lastSaved.properties.Title.title[0].plain_text;\n} catch (e) {\n  lastSavedTitle = \"\";\n}\n\nif (latestScraped && latestScraped !== lastSavedTitle) {\n  return [ { json: { latest_message: latestScraped, is_new: true } } ];\n}\n\nreturn [];"
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Check If New Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        240
      ]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "databaseId": {
          "__rl": true,
          "mode": "list",
          "value": "36bb03d4-b238-81e1-bcdb-e5fb769c90c6"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Title|title",
              "title": "={{ $json.latest_message }}"
            },
            {
              "key": "URL|url",
              "urlValue": "https://t.me/s/us_visa_slots_alerts"
            },
            {
              "key": "Published Date|date",
              "date": "={{ new Date().toISOString() }}"
            }
          ]
        }
      },
      "id": "77777777-7777-7777-7777-777777777777",
      "name": "Save New Slot to Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.1,
